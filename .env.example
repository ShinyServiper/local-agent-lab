# Copy this file to .env and edit. docker compose reads .env automatically.

# Model Ollama downloads on first start and the agent uses
OLLAMA_MODEL=qwen3.5:2b

# Key Open WebUI sends to the agent as "Authorization: Bearer <key>"
AGENT_API_KEY=change-me

# Secret Open WebUI uses to sign logins (any long random string)
WEBUI_SECRET_KEY=change-me-too

# Time zone used by the get_current_date tool and Open WebUI
TZ=America/New_York

# Host ports (change if something else on this machine already uses them)
OPENWEBUI_HOST_PORT=3000
AGENT_HOST_PORT=5005
OLLAMA_HOST_PORT=11435
PHOENIX_HOST_PORT=6006
PHOENIX_GRPC_HOST_PORT=4317
